# Environnement virtuel
.venv/

# Configuration locale (générée au premier lancement, spécifique à l'installation)
config.json
config.json.tmp
config.json.bak

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Données locales (médiathèque vidéo)
videos/*.mp4
videos/*.mjpg
videos/*.webm
videos/*.jpg
videos/*.jpeg
videos/index.json
videos/.bobrov_index.json

# Rapports de bug (texte libre saisi dans l'interface ; API /api/bugs)
Rapport_bug/data/*.json

# Journaux locaux : le répertoire est conservé pour les déploiements.
logs/*
!logs/.gitkeep

# Certificats TLS auto-signés (deploy/gen-cert.sh) : propres à chaque machine
deploy/tls/

# Divers
*.bak
*.log
/.tmp_*
.DS_Store
